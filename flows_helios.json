    {
        "id": "ea4192a101c6c2d9",
        "type": "function",
        "z": "1011ac88853ea072",
        "name": "Processar e Exibir",
        "func": "var dados = msg.payload;\nif (typeof dados === \"string\") {\n    try {\n        dados = JSON.parse(dados);\n    } catch(e) {\n        node.error(\"JSON inválido: \" + dados);\n        return null;\n    }\n}\n\nif (!dados || typeof dados !== \"object\") {\n    node.error(\"Payload inválido: \" + JSON.stringify(dados));\n    return null;\n}\n\nvar mensagem = \"\";\nmensagem += \"📡 DISPOSITIVO: \" + dados.dispositivo + \"\\n\";\nmensagem += \"🌡️ TEMPERATURA: \" + dados.temperatura + \"°C\\n\";\nmensagem += \"💧 UMIDADE: \" + dados.umidade + \"%\\n\";\nmensagem += \"📊 STATUS: \" + dados.status + \"\\n\";\nmensagem += \"⚡ EFICIÊNCIA: \" + dados.eficiencia + \"%\\n\";\nmensagem += \"🔧 RECOMENDAÇÃO: \" + dados.recomendacao + \"\\n\";\nmensagem += \"────────────────────────\";\n\nmsg.temperatura = dados.temperatura;\nmsg.umidade = dados.umidade;\nmsg.eficiencia = dados.eficiencia;\nmsg.dispositivo = dados.dispositivo;\nmsg.recomendacao = dados.recomendacao;\nmsg.status = dados.status;\n\nif (dados.status === \"CRITICO\" || dados.status === \"ALERTA\") {\n    msg.sendEmail = true;\n} else {\n    msg.sendEmail = false;\n}\n\nmsg.topic = \"🚨 Helios DataHub - Alerta \" + dados.status + \" | \" + dados.dispositivo;\nmsg.payload = mensagem;\n\nreturn msg;",
